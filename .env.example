# Copy to .env and fill in real values. Only VITE_-prefixed vars reach the
# browser — treat them as PUBLIC. The Supabase anon/publishable key is safe
# client-side; get both from Supabase → Project Settings → API.
#
# NEVER put the Supabase service_role key here or in any VITE_ var — it is
# server-only and must never reach the client bundle. .env is gitignored;
# this .env.example holds placeholders only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# ---------------------------------------------------------------------------
# SERVER-ONLY (only if you later add a sync agent — see the
# vibe-coding-with-confidence skill). NOT used by the web app. Never
# VITE_-prefixed, never committed. The service_role key bypasses RLS and must
# stay server-side only.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# EDGE-FUNCTION SECRET (AI Quality / evals). The `run-eval` function calls
# Anthropic server-side; the key NEVER reaches the browser and is NOT a VITE_
# var. Set it on the Supabase project, not in this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# (CI can set it from a GitHub Actions secret — see
#  .github/workflows/supabase-functions.yml).
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key
